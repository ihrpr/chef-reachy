# Hugging Face Configuration
# Directory for caching downloaded models (defaults to ~/.cache/huggingface if not set)
# HF_HOME=~/.cache/huggingface

# Optional: Hugging Face token for accessing gated models
# You can get a token from https://huggingface.co/settings/tokens
# HF_TOKEN=your_token_here

# Vision model to use (default: OWL-ViT base)
VISION_MODEL=google/owlvit-base-patch32

# Vision Detection Configuration
# Device preference: auto (default), cuda, or cpu
# - auto: automatically selects CUDA on NVIDIA, or CPU
# - cuda: force CUDA (requires NVIDIA GPU)
# - cpu: force CPU (slower but works everywhere)
VISION_DEVICE=auto

# Detection confidence threshold (0.0-1.0, lower = more detections, higher = more confident)
VISION_DETECTION_THRESHOLD=0.15

# JPEG quality for image encoding (1-100, higher = better quality but larger size)
VISION_JPEG_QUALITY=85

# Optional: Custom labels for detecting hand holding food (comma-separated list)
# If not set, defaults defined in chef_reachy/vision/config.py will be used
# Example: FOOD_LABELS=hand holding food,hand with food,hand

# Camera tracking settings
# ENABLE_TRACKING=true  # Enable automatic camera tracking to follow detected hand
# TRACKING_KP=1.0  # Proportional gain for tracking (higher = faster response)
# TRACKING_UPDATE_RATE=2.5  # Update rate in seconds (default: 2.5s = ~0.4Hz, matches OWL-ViT inference time)
# MAX_ROTATION_DEG=30.0  # Maximum rotation angle in degrees
