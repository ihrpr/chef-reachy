# Hugging Face Configuration
# Directory for caching downloaded models (defaults to ~/.cache/huggingface if not set)
# HF_HOME=~/.cache/huggingface

# Optional: Hugging Face token for accessing gated models
# You can get a token from https://huggingface.co/settings/tokens
# HF_TOKEN=your_token_here

# Vision model to use (default: SmolVLM2-2.2B-Instruct)
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Vision Processing Configuration
# Device preference: auto (default), cuda, mps, or cpu
# - auto: automatically selects MPS on Apple Silicon, CUDA on NVIDIA, or CPU
# - cuda: force CUDA (requires NVIDIA GPU)
# - mps: force MPS (requires Apple Silicon)
# - cpu: force CPU (slower but works everywhere)
VISION_DEVICE=auto

# Maximum number of tokens to generate in vision response
VISION_MAX_TOKENS=64

# JPEG quality for image encoding (1-100, higher = better quality but slower)
VISION_JPEG_QUALITY=85
